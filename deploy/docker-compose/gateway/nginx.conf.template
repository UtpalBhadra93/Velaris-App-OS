# Velaris API Gateway (roadmap #13a — the API gateway prefix GATE).
#
# Single ingress for all client / SDK / marketplace-package traffic. Routes by
# stable path sub-prefix to the owning service. The client-facing prefix
# (/api/v1/...) is IDENTICAL before and after service extraction (#13c-e):
# today every upstream resolves to the case-service monolith, so this config
# ships with ZERO behaviour change. When a service is extracted, only the
# `server` line in its upstream changes — no client, SDK, or package edits.
#
# See docs/Future/Done/tier2-sequence-and-service-extraction.md.

worker_processes auto;
events { worker_connections 1024; }

http {
    access_log /dev/stdout;
    error_log  /dev/stderr;

    # ── Extraction seams ──────────────────────────────────────────
    # 13c-e are done. Every extraction target now answers on its own port;
    # case-service keeps everything else. The client-facing prefixes never
    # changed, which was the whole point of doing 13a first.
    # Ports come from the environment (2026-08-24): a client whose machine
    # already uses one of these can move it in .env instead of editing this
    # file, and the installer asks before anything binds. The nginx image's
    # entrypoint substitutes them; the defaults live in
    # deploy/ports/velaris-ports.sh and are the values the platform always had.
    upstream case_service      { server 127.0.0.1:${VELARIS_CASE_PORT}; }
    upstream analytics_service { server 127.0.0.1:${VELARIS_ANALYTICS_PORT}; }  # 13c: EXTRACTED 2026-08-23
    upstream hxgraph_service   { server 127.0.0.1:${VELARIS_HXGRAPH_PORT}; }  # 13d: EXTRACTED 2026-08-23
    upstream hxmigrate_service { server 127.0.0.1:${VELARIS_HXMIGRATE_PORT}; }  # 13e: EXTRACTED 2026-08-23

    map $http_upgrade $connection_upgrade { default upgrade; '' close; }

    # ── Rate limiting at the door (roadmap #24) ───────────────────
    #
    # §2.5 proposed doing this at a CDN edge. That is the wrong shape for a
    # self-hosted, sovereignty-first product — it puts a third party in front of
    # the least-trusted surface — and it was never built, so until 2026-08-24
    # the platform had **no rate limiting at the gateway at all**. What existed
    # was in-process, per service (four buckets for one attacker since 13c-e),
    # and reset on restart, which its own comment said.
    #
    # Keyed on $binary_remote_addr, the peer nginx actually sees. Deliberately
    # NOT on X-Forwarded-For: a header the client controls is a rate-limit
    # bypass, and behind a real proxy the fix is `set_real_ip_from`, not trust.
    #
    # Two zones because the surfaces differ. The portal is anonymous and public
    # and gets the tighter one; the rest of the API is authenticated and its
    # callers are Studio and the SDK, which burst legitimately.
    # The rates are substituted so an operator can raise them without editing a
    # repository file an update would overwrite. Unset (or set empty) renders
    # the values the platform has always shipped — see docker-compose.yml.
    limit_req_zone $binary_remote_addr zone=velaris_portal:10m rate=${VELARIS_GW_RATE_PORTAL};
    limit_req_zone $binary_remote_addr zone=velaris_api:10m    rate=${VELARIS_GW_RATE_API};
    limit_req_status 429;
    limit_req_log_level warn;

    # A request limit does not bound a WEBSOCKET: one request per connection,
    # and then the connection is held (proxy_read_timeout 3600s below). One
    # host could hold every worker connection open and no rate limit would say
    # a word. So the long-lived paths get a CONNECTION cap as well.
    #
    # The default is deliberately high (see docker-compose.yml). An office
    # behind one NAT address is a single $binary_remote_addr to nginx, so a
    # tight cap here does not stop an attacker so much as break a floor of
    # staff — and this must be safe on an install that takes the update
    # unattended. It is a ceiling on exhaustion, not traffic shaping.
    limit_conn_zone $binary_remote_addr zone=velaris_ws:10m;
    limit_conn_status 429;
    limit_conn_log_level warn;

    # ── Request body ceiling ──────────────────────────────────────
    #
    # Found 2026-09-09, and it had been true since the gateway shipped: nginx's
    # DEFAULT is 1 MB and this file never set one, while the application allows
    # 25 MB (`config.py::max_upload_bytes`). The two disagreed by 25×, so every
    # document over 1 MB was refused at the door with a bare nginx **413** that
    # names nothing — no error code, no reason, and an application that believes
    # it accepts the file. A scanned PDF, which is what the new OCR path exists
    # to read, is almost always over 1 MB.
    #
    # Set to the application's own limit so the app is what refuses, with a
    # coded error saying why. This is permissive relative to today, so nothing
    # that works now stops working; keep the two numbers in step.
    client_max_body_size 25m;

    # ── Internal TLS (roadmap #18) — OFF unless the certificates exist ──
    # Both of these are substituted at container start. With internal TLS off
    # they are "http" and an empty file, so this config is byte-for-byte the
    # plaintext one; with it on, every proxy_pass speaks https and presents the
    # gateway's client certificate. One template, no second copy to drift.
    include /etc/nginx/proxy_ssl.conf;

    server {
        listen 127.0.0.1:${VELARIS_CASE_SERVICE_PORT};

        # Headers inherited by every location below.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Workload identity (roadmap #18). Every service refuses a request that
        # does not carry this, so the gateway becomes the only CALLER and not
        # merely the only route — a local process opening 127.0.0.1:8202 gets a
        # 403 instead of an authenticated API.
        #
        # `proxy_set_header` REPLACES whatever the client sent, so a caller
        # cannot smuggle their own value through the gateway.
        #
        # ${VELARIS_GATEWAY_IDENTITY_SECRET} is substituted by the nginx image's
        # entrypoint at container start (this file is mounted into
        # /etc/nginx/templates/), which is why the secret lives in .env and never
        # in the repository.
        #
        # The QUOTES are load-bearing. An existing install that takes an update
        # has no secret yet (`update-velaris.sh` deliberately never generates
        # one), so this substitutes to nothing — and unquoted, nginx reads a
        # directive with one argument and refuses to START, taking the whole
        # platform down on an upgrade that was supposed to change nothing.
        # Quoted, an empty value is nginx's documented way to REMOVE a header:
        # nothing is sent, the services see no identity header, and they already
        # treat "no secret configured" as "check off". Off stays off; turning it
        # on stays a deliberate operator step.
        proxy_set_header X-Velaris-Gateway "${VELARIS_GATEWAY_IDENTITY_SECRET}";
        proxy_read_timeout 120s;

        # ── The rate limit lives HERE, at the server, not in one location ──
        # It was in `location /` alone until 2026-09-09, and nginx does NOT add
        # a limit to a location that declares none at its own level — it
        # inherits only when the enclosing level has one. So every named prefix
        # below (analytics, graph, hxmigrate, importer, scout, scout-ai,
        # orchestrator, process-mining, realtime, hxstream, meet) proxied with
        # NO limit at all, and an attacker picks the path. A limit on some
        # paths is a limit on none.
        #
        # A location that needs a different budget overrides this by declaring
        # its own — nginx takes the innermost level, it does not apply both.
        # /api/v1/portal does exactly that.
        limit_req zone=velaris_api burst=40 nodelay;

        # ── Gateway discovery (§6.4) ──────────────────────────────
        # SDK v2 + marketplace packages resolve the stable base from here,
        # never from a hardcoded service address.
        location = /.well-known/velaris-gateway {
            default_type application/json;
            return 200 '{"gateway_base":"/api/v1","api_version":"1","services":{"analytics":"/api/v1/analytics","process_mining":"/api/v1/process-mining","graph":"/api/v1/graph","hxmigrate":"/api/v1/hxmigrate","importer":"/api/v1/importer","scout":"/api/v1/scout","scout_ai":"/api/v1/scout-ai","orchestrator":"/api/v1/orchestrator"}}';
        }

        # ── Extraction sub-prefixes (seams) ───────────────────────
        # No trailing slash: with one, `/api/v1/analytics` (and anything
        # with a query string but no slash) falls through to `location /` and
        # reaches case-service, which no longer serves these prefixes at all.
        # That was harmless while every upstream was the same process.
        location /api/v1/analytics      { proxy_pass ${VELARIS_UPSTREAM_SCHEME}://analytics_service; }
        location /api/v1/process-mining { proxy_pass ${VELARIS_UPSTREAM_SCHEME}://analytics_service; }
        location /api/v1/graph          { proxy_pass ${VELARIS_UPSTREAM_SCHEME}://hxgraph_service; }
        location /api/v1/hxmigrate      { proxy_pass ${VELARIS_UPSTREAM_SCHEME}://hxmigrate_service; }
        # The migration domain is five prefixes, not one: bpm_importer, scout
        # and orchestrator moved with hxmigrate at 13e because the four packages
        # import each other. Only /hxmigrate had a seam, so these four are new.
        location /api/v1/importer      { proxy_pass ${VELARIS_UPSTREAM_SCHEME}://hxmigrate_service; }
        location /api/v1/scout         { proxy_pass ${VELARIS_UPSTREAM_SCHEME}://hxmigrate_service; }
        location /api/v1/scout-ai      { proxy_pass ${VELARIS_UPSTREAM_SCHEME}://hxmigrate_service; }
        location /api/v1/orchestrator  { proxy_pass ${VELARIS_UPSTREAM_SCHEME}://hxmigrate_service; }

        # ── WebSocket (realtime) ──────────────────────────────────
        location /api/v1/realtime {
            limit_conn velaris_ws ${VELARIS_GW_WS_CONN_MAX};
            proxy_pass ${VELARIS_UPSTREAM_SCHEME}://case_service;
            proxy_http_version 1.1;
            # A location that sets ANY proxy_set_header drops every server-level
            # one, so the full set is repeated here — including the workload
            # identity header, without which the websocket would be refused.
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Velaris-Gateway "${VELARIS_GATEWAY_IDENTITY_SECRET}";
            proxy_set_header Upgrade    $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 3600s;
        }

        # ── WebSocket (HxStream live activity) ────────────────────
        # Mixed path: serves both HTTP routes (/event, /events, …) and the
        # WS route (/ws). A location that sets proxy_set_header drops the
        # server-level ones, so re-declare them here alongside the upgrade
        # headers. For non-WS requests $connection_upgrade maps to "close".
        location /api/v1/hxstream {
            limit_conn velaris_ws ${VELARIS_GW_WS_CONN_MAX};
            proxy_pass ${VELARIS_UPSTREAM_SCHEME}://case_service;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Velaris-Gateway "${VELARIS_GATEWAY_IDENTITY_SECRET}";
            proxy_set_header Upgrade           $http_upgrade;
            proxy_set_header Connection        $connection_upgrade;
            proxy_read_timeout 3600s;
        }

        # ── WebSocket (HxMeet P4a-live caption stream) ────────────
        # Mixed path like /hxstream: /meet is mostly HTTP, plus the WS
        # captions route — same header re-declaration rule applies.
        location /api/v1/meet {
            limit_conn velaris_ws ${VELARIS_GW_WS_CONN_MAX};
            proxy_pass ${VELARIS_UPSTREAM_SCHEME}://case_service;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Velaris-Gateway "${VELARIS_GATEWAY_IDENTITY_SECRET}";
            proxy_set_header Upgrade           $http_upgrade;
            proxy_set_header Connection        $connection_upgrade;
            proxy_read_timeout 3600s;
        }

        # ── Layer-2 data broker: container-only surface ───────────
        # Served EXCLUSIVELY on the edge listener below; on the main
        # gateway it doesn't exist. (Its own token auth still applies —
        # this is defense in depth, not the auth boundary.)
        location /api/v1/broker { return 404; }

        # Same reasoning for the bot result path: a container POSTs there with
        # its per-job token over the apps-network bridge. Nothing arrives here
        # from a browser, so the public gateway does not serve it.
        location ~ "^/api/v1/bots/jobs/[0-9a-fA-F-]{36}/(result|progress)$" { return 404; }

        # ── Everything else -> case-service (the monolith) ────────
        # The public, anonymous, most-attacked surface. burst=20 with nodelay
        # absorbs a form submission's own fan-out without letting a script
        # sustain more than the zone rate.
        location /api/v1/portal {
            limit_req zone=velaris_portal burst=20 nodelay;
            proxy_pass ${VELARIS_UPSTREAM_SCHEME}://case_service;
        }

        # Everything else. burst=40 is generous on purpose: this must not be the
        # thing that makes a busy Studio session feel broken, and the point here
        # is a ceiling on abuse, not traffic shaping. /health, /ready and
        # /metrics are inside this too — a supervisor polling every few seconds
        # is nowhere near 20r/s, and exempting them by path would hand an
        # attacker an unlimited door.
        location / {
            # No limit_req here: it is declared at the server level above and
            # inherited, so the ceiling is stated once for every location
            # rather than in the one place somebody remembered.
            proxy_pass ${VELARIS_UPSTREAM_SCHEME}://case_service;
        }
    }

    # ── Apps-network edge listener ────────────────────────────────
    # Bound on the velaris-apps-edge gateway interface (a HOST interface —
    # this nginx is host-networked). The velaris-broker-gw container proxies
    # apps-network traffic here, and ONLY the two paths below are served: the
    # scoped data broker, and how a bot container returns its work. A
    # container therefore reaches those and nothing else, and case-service
    # itself stays loopback-only.
    server {
        listen 172.31.101.1:8210;

        # NOT rate-limited, deliberately (2026-09-09). Every request here
        # arrives through the velaris-broker-gw container, so
        # $binary_remote_addr is the BROKER's address for every bot alike —
        # one bucket shared by all of them. A limit keyed on it would let one
        # chatty package starve every other container's result callback while
        # doing nothing to a determined one. The controls that do apply are
        # the per-job token and this listener serving two paths and no others;
        # bounding a single package's rate belongs in the runner that starts
        # it, where the identity is known.

        proxy_set_header Host            $host;
        proxy_set_header X-Real-IP       $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # The apps-network edge is still the gateway, so it identifies as one.
        # Without this a bot container returning its work would be refused.
        proxy_set_header X-Velaris-Gateway "${VELARIS_GATEWAY_IDENTITY_SECRET}";
        proxy_read_timeout 30s;

        location /api/v1/broker { proxy_pass ${VELARIS_UPSTREAM_SCHEME}://case_service; }

        # A bot container returning its work. The per-job token is the
        # credential; this listener bounds *which paths* a container may reach
        # at all, so a leaked token still cannot touch the bot registry.
        location ~ "^/api/v1/bots/jobs/[0-9a-fA-F-]{36}/(result|progress)$" {
            proxy_pass ${VELARIS_UPSTREAM_SCHEME}://case_service;
        }

        location / { return 404; }
    }
}
