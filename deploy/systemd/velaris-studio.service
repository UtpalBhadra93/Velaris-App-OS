[Unit]
Description=Velaris Studio — web UI (:5173)
After=network-online.target velaris-case-service.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=__VELARIS_USER__
WorkingDirectory=__VELARIS_DIR__/studio
# Historical default; .env below overrides it when the install sets a port.
Environment=VELARIS_STUDIO_PORT=5173
EnvironmentFile=__VELARIS_DIR__/.env
Environment=PATH=__VELARIS_HOME__/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production

# Serves the BUILT bundle (`vite preview`), not the dev server: no HMR
# websocket, no unminified source, no on-the-fly transform of the whole tree.
# It still binds 0.0.0.0 because it is the only ingress this deployment has —
# the API gateway listens on 127.0.0.1 only — so port 5173 must be closed to
# anything but your users' network by the firewall (setup-velaris.sh offers it).
# The long-term shape is still nginx on 443 with /api/v1 proxied to 127.0.0.1:8201.
#
# `preview` does NOT inherit `server.proxy`; vite.config.ts declares a matching
# `preview.proxy` for exactly this. Removing it 404s every API call.
#
# ExecStartPre builds only when `dist` is missing, so a restart is not a
# two-minute outage. Deploys must rebuild: `npm run build` in studio/.
# (velaris-exec.sh takes the REPO root — it reads velaris.yaml from it. The
# studio directory comes from WorkingDirectory= above.)
ExecStartPre=__EXEC__ __VELARIS_DIR__ /bin/sh -c "test -d dist || __NPM__ run build"
# --strictPort is the point of this line. Without it vite preview finds the
# port busy and quietly takes the next one: the unit says 5173, the browser
# needs 5174, and nothing reports a problem — which is exactly what happened
# on 2026-08-24. Every other service fails loudly when its port is taken;
# this one drifted. Fail instead, so systemd marks the unit failed and the
# operator learns it now rather than from a blank page.
ExecStart=__EXEC__ __VELARIS_DIR__ __NPM__ run preview -- --host 0.0.0.0 --port ${VELARIS_STUDIO_PORT} --strictPort

Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=velaris-studio

# Vite + esbuild are the most memory-hungry things on the box and node's default
# heap can outgrow a small server. Capping the heap turns a silent OOM kill into
# a JS heap error in the journal — which is the difference between a diagnosable
# outage and today's dead end. Raise if builds start failing.
Environment=NODE_OPTIONS=--max-old-space-size=2048
MemoryAccounting=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
