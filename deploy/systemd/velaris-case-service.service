[Unit]
Description=Velaris Case Service — API (loopback 127.0.0.1:8201, fronted by nginx on 8200)
After=network-online.target docker.service
Wants=network-online.target
# Never stop trying: a service that gives up after N restarts is a service that
# is down at 3am with no one watching.
StartLimitIntervalSec=0

[Service]
Type=simple
User=__VELARIS_USER__
WorkingDirectory=__VELARIS_DIR__
EnvironmentFile=__VELARIS_DIR__/.env
Environment=PATH=__VELARIS_HOME__/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# --reload is deliberately absent. It is a development convenience that forks a
# file-watching supervisor, which confuses systemd's process tracking and would
# mask a crash as a reload. Code changes come through update-velaris.sh, which
# restarts the unit.
ExecStart=__EXEC__ __VELARIS_DIR__ __UV__ run uvicorn case_service.main:app --host 127.0.0.1 --port 8201 --app-dir services/case-service

Restart=always
RestartSec=5
# uvicorn shuts down cleanly on SIGINT; SIGTERM leaves connections hanging.
KillSignal=SIGINT
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=velaris-case-service

# Records peak memory per run, so `systemctl status` and journald can show an
# OOM for what it is instead of leaving you guessing as we did today.
MemoryAccounting=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
