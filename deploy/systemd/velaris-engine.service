[Unit]
Description=Velaris Engine — BPM runtime (:8100)
After=network-online.target docker.service
Wants=network-online.target
# Requires, not just After: the database and Temporal are both containers, so
# without a running Docker daemon this service has nothing to talk to.
Requires=docker.service
# Never stop trying: a service that gives up after N restarts is a service that
# is down at 3am with no one watching.
StartLimitIntervalSec=0

[Service]
Type=simple
User=__VELARIS_USER__
WorkingDirectory=__VELARIS_DIR__
# Historical default; .env below overrides it when the install sets a port.
Environment=VELARIS_ENGINE_PORT=8100
EnvironmentFile=__VELARIS_DIR__/.env
Environment=PATH=__VELARIS_HOME__/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# --reload is deliberately absent. It is a development convenience that forks a
# file-watching supervisor, which confuses systemd's process tracking and would
# mask a crash as a reload. Code changes come through update-velaris.sh, which
# restarts the unit.
#
# ExecStartPre blocks until the database is accepting connections — see the note
# in velaris-case-service.service and the header of velaris-wait-deps.sh.
ExecStartPre=__WAITDEPS__ __VELARIS_DIR__
ExecStart=__EXEC__ __VELARIS_DIR__ __UV__ run uvicorn helix_engine.main:app --host 127.0.0.1 --port ${VELARIS_ENGINE_PORT} --proxy-headers

Restart=always
RestartSec=5
# Must exceed the ExecStartPre wait (90s) so systemd reports the real cause
# rather than a start-up timeout.
TimeoutStartSec=180
# uvicorn shuts down cleanly on SIGINT; SIGTERM leaves connections hanging.
KillSignal=SIGINT
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=velaris-engine

# Records peak memory per run, so `systemctl status` and journald can show an
# OOM for what it is instead of leaving you guessing as we did today.
MemoryAccounting=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
