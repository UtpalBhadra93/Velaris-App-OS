[
  {
    "id": "rl-claims-highvalue",
    "name": "Claims — high value needs second approver",
    "version": "1.0",
    "rule_type": "expression",
    "scope": "case_type",
    "scope_target_id": "ct-claims-0001",
    "enabled": true,
    "priority": 10,
    "definition_json": {
      "description": "Settlements above 10,000 require a second approver before payment.",
      "expression": "settlement_value > 10000",
      "action": "require_second_approval"
    }
  },
  {
    "id": "rl-claims-urgent",
    "name": "Claims — escalate suspected fraud",
    "version": "1.0",
    "rule_type": "expression",
    "scope": "case_type",
    "scope_target_id": "ct-claims-0001",
    "enabled": true,
    "priority": 20,
    "definition_json": {
      "description": "An assessor flagging fraud indicators raises priority and routes to the SIU queue.",
      "expression": "fraud_indicators == True",
      "action": "escalate"
    }
  },
  {
    "id": "rl-claims-excess",
    "name": "Claims — below excess",
    "version": "1.0",
    "rule_type": "expression",
    "scope": "case_type",
    "scope_target_id": "ct-claims-0001",
    "enabled": true,
    "priority": 30,
    "definition_json": {
      "description": "A claim assessed below the policy excess is not payable — flag for decline with reason.",
      "expression": "assessed_value <= excess_amount",
      "action": "flag_decline"
    }
  }
]
