# Velaris — environment variables
#
# HOW TO USE:
#   setup-velaris.sh creates .env automatically on first run.
#   You only need to edit this for AI provider keys and optional overrides.
#   Never commit .env — only .env.example belongs in git.
#
#   Commented variables show their built-in default — uncomment to override.

# ════════════════════════════════════════════════════════════════════
#  INFRASTRUCTURE — auto-generated by setup-velaris.sh
#  Do not set these manually; let the setup script generate them.
# ════════════════════════════════════════════════════════════════════

# Shared password for PostgreSQL (helix-db) and Keycloak (KC_DB).
# Auto-generated as a random 32-char hex string during setup.
VELARIS_DB_PASSWORD=

# Keycloak admin console password (separate from the DB password).
# Auto-generated during setup.
VELARIS_ADMIN_PASSWORD=

# OpenSearch admin password (only relevant if the search profile is enabled).
VELARIS_SEARCH_PASSWORD=

# Also auto-generated into .env by setup-velaris.sh (listed for reference):
#   VELARIS_CASE_AUTH_SECRET           — JWT fallback secret (random hex)
#   VELARIS_CASE_STORAGE_MASTER_KEY    — AES-256-GCM key for documents at rest
#   VELARIS_CASE_AUTH_RSA_PRIVATE_KEY  — RS256 signing key (PEM, \n-escaped)
#   VELARIS_CASE_AUTH_RSA_PUBLIC_KEY   — RS256 verification key (PEM, \n-escaped)

# ════════════════════════════════════════════════════════════════════
#  MUST SET IN PRODUCTION — these have insecure defaults
# ════════════════════════════════════════════════════════════════════

# JWT signing secret — setup-velaris.sh generates a random one when empty.
# Generate manually: openssl rand -hex 32
# Left empty/unset, the code falls back to a known dev string and prints a
# SECURITY WARNING at startup. (RS256 keys, when set, take precedence anyway.)
VELARIS_CASE_AUTH_SECRET=

# Database — populated from VELARIS_DB_PASSWORD by setup-velaris.sh
VELARIS_CASE_DATABASE_URL=postgresql+asyncpg://helix:REPLACE@localhost:5432/helix

# Document storage path. setup-velaris.sh provisions <install-dir>/data/documents
# and sets this automatically. Override here only to point elsewhere.
# VELARIS_CASE_STORAGE_LOCAL_PATH=/path/to/documents

# ════════════════════════════════════════════════════════════════════
#  AUTH & TOKENS
# ════════════════════════════════════════════════════════════════════

# Access tokens are short-lived; refresh tokens rotate on every use.
# VELARIS_CASE_ACCESS_TOKEN_EXPIRY_MINUTES=15
# Refresh token lifetime in days (also overridable in the admin settings UI).
# VELARIS_CASE_TOKEN_EXPIRY_DAYS=60

# Auth mode: "jwt" (default) or "oidc" (external IdP).
# VELARIS_CASE_AUTH_MODE=jwt
# VELARIS_CASE_AUTH_ISSUER=helix
# VELARIS_CASE_AUTH_AUDIENCE=helix-api
# VELARIS_CASE_OIDC_DISCOVERY_URL=
# VELARIS_CASE_OIDC_CLIENT_ID=helix-studio

# ════════════════════════════════════════════════════════════════════
#  SECURITY — REQUEST BODY SIZE LIMITS (Group D, values in bytes)
# ════════════════════════════════════════════════════════════════════

# JSON payloads — 10 MB default.
# VELARIS_CASE_MAX_BODY_BYTES=10485760
# Multipart file uploads (documents, portal, HxNexus, importer) — 25 MB default.
# VELARIS_CASE_MAX_UPLOAD_BYTES=26214400
# HxMigrate BPM vendor exports only — 200 MB transport cap
# (hxmigrate's SEC-7 still enforces 100 MB per file inside the request).
# VELARIS_CASE_MAX_MIGRATE_UPLOAD_BYTES=209715200

# ════════════════════════════════════════════════════════════════════
#  DATABASE CONNECTION POOLS (Group C)
#  Three isolated pools: operations / auth / analytics.
#  Exhausting one pool can never starve the others.
# ════════════════════════════════════════════════════════════════════

# Operations pool — case CRUD, forms, general endpoints.
# VELARIS_CASE_DB_POOL_SIZE=10
# VELARIS_CASE_DB_MAX_OVERFLOW=5
# Dedicated auth pool — login, refresh, token checks.
# VELARIS_CASE_DB_AUTH_POOL_SIZE=3
# Analytics pool — reporting, compliance, sync, sitemap.
# VELARIS_CASE_DB_ANALYTICS_POOL_SIZE=3
# Echo SQL statements to the log (debug only — very verbose).
# VELARIS_CASE_DB_ECHO=false
#
# Read-only replica (hot standby) for HEAVY ANALYTICS QUERIES only —
# dashboard, metrics, OData feed. Compliance/sync/PUO and anything that
# writes always stay on the primary. Empty = analytics queries use the
# primary too. (Group I)
# VELARIS_CASE_DB_ANALYTICS_URL=postgresql+asyncpg://helix:pass@replica-host:5432/helix

# ── Webhooks (Group I) — thin events ──
# Webhook payloads carry IDs + status only; set true to embed full case
# variables in outbox payloads (legacy consumers only).
# VELARIS_CASE_WEBHOOK_FULL_PAYLOADS=false

# ── Audit chain external anchoring (Group I) — RFC-3161 ──
# A timestamp authority signs the audit-chain tip daily, making history
# externally provable. Default TSA is freetsa.org; any RFC-3161 TSA works.
# VELARIS_CASE_AUDIT_ANCHOR_ENABLED=true
# VELARIS_CASE_AUDIT_TSA_URL=https://freetsa.org/tsr
# VELARIS_CASE_AUDIT_ANCHOR_INTERVAL_HOURS=24

# ── WebAuthn / passkeys (Group J) ──
# rp_id must be the registrable domain the app is served from; origin must
# match the browser origin EXACTLY (scheme + host + port) or every passkey
# ceremony fails verification. Production example: rp_id=velaris.example.com,
# origin=https://velaris.example.com
# VELARIS_CASE_WEBAUTHN_RP_ID=localhost
# VELARIS_CASE_WEBAUTHN_RP_NAME=Velaris
# VELARIS_CASE_WEBAUTHN_ORIGIN=http://localhost:5173

# ════════════════════════════════════════════════════════════════════
#  UNIFIED AI BACKEND
#  Used by ALL AI features: HxNexus, NLP Builder, Scout AI, BPM Importer.
# ════════════════════════════════════════════════════════════════════
#
# ── AI egress policy (Group E) — controls what may leave the platform ──
#   local_only — external AI providers refused; local Ollama used instead
#   minimized  — external completions allowed, embeddings ALWAYS stay local
#                (document content never leaves the platform at index time)
#   full       — external provider used as-is (explicit opt-in)
# Note: switching an externally-indexed deployment to "minimized" requires
# re-indexing documents (embedding spaces are not comparable).
VELARIS_CASE_AI_EGRESS_POLICY=minimized
#
# Chunk minimization when completions go to an external provider (Group H):
# VELARIS_CASE_AI_EGRESS_TOP_K=3
# VELARIS_CASE_AI_EGRESS_MIN_SCORE=0.25
# VELARIS_CASE_AI_EGRESS_MAX_CONTEXT_CHARS=6000
#
# HxNexus document Q&A — chunking and rerank. Unset = as before.
#   CHUNK_STRATEGY: window (default) | structure (headings/paragraphs/sentences).
#     Applies to documents indexed after it is set; existing chunks are not
#     touched and stay answerable. Re-index a case to re-cut its documents.
#   RERANK: off (default) | lexical (cosine blended with a keyword score;
#     local arithmetic, nothing is sent to any provider).
# VELARIS_CASE_HXNEXUS_CHUNK_STRATEGY=structure
# VELARIS_CASE_HXNEXUS_RERANK=lexical
# VELARIS_CASE_HXNEXUS_RERANK_CANDIDATES=20
# VELARIS_CASE_HXNEXUS_RERANK_LEXICAL_WEIGHT=0.3
#
# HxPrivacy — further surfaces. Each is separate, each is off unless set, and
# none is implied by VELARIS_CASE_PII_REDACT_EXPORTS. Only findings a reviewer
# has CONFIRMED are used.
#   TABLE_EXPORTS: mask confirmed fields in the Database Manager's table export.
#   MASK_AI_EGRESS: mask the values of a case's confirmed fields in text sent to
#     an external AI provider (restored in the answer).
#   ANONYMIZE_CASE_TEXT: retention's `anonymize` also blanks the case's messages,
#     channel messages and HxNexus conversations. IRREVERSIBLE.
# VELARIS_CASE_PII_REDACT_TABLE_EXPORTS=true
# VELARIS_CASE_PII_MASK_AI_EGRESS=true
# VELARIS_CASE_RETENTION_ANONYMIZE_CASE_TEXT=true
#
# ══════════════════════════════════════════════════════════════════
#  SIMPLE (recommended) — set only these 3-4 vars for ANY provider.
#  The system auto-resolves the API endpoint. Zero code changes needed.
# ══════════════════════════════════════════════════════════════════
#
#  Supported values for VELARIS_CASE_AI_PROVIDER:
#    ollama      — local, free, no API key needed (default)
#    openai      — OpenAI (GPT-4o, GPT-4o-mini, etc.)
#    anthropic   — Anthropic (Claude) — uses native Anthropic SDK
#    groq        — Groq (fastest inference, llama/mixtral models)
#    mistral     — Mistral AI
#    gemini      — Google Gemini (via OpenAI-compatible endpoint)
#    together    — Together AI (llama, qwen, etc.)
#    fireworks   — Fireworks AI
#    perplexity  — Perplexity AI
#    deepseek    — DeepSeek
#    xai         — xAI (Grok)
#    cohere      — Cohere
#    custom      — any OpenAI-compatible API (set VELARIS_CASE_AI_BASE_URL too;
#                  a localhost BASE_URL counts as local for the egress policy)
#
VELARIS_CASE_AI_PROVIDER=ollama
VELARIS_CASE_AI_API_KEY=
VELARIS_CASE_AI_MODEL=
VELARIS_CASE_AI_EMBED_MODEL=
VELARIS_CASE_AI_BASE_URL=
#
# Examples:
#   Groq:    PROVIDER=groq   API_KEY=gsk_xxx  MODEL=llama-3.1-70b-versatile
#   Gemini:  PROVIDER=gemini API_KEY=xxx      MODEL=gemini-1.5-flash
#   Mistral: PROVIDER=mistral API_KEY=xxx     MODEL=mistral-large-latest
#   Custom:  PROVIDER=custom  API_KEY=xxx     MODEL=my-model  BASE_URL=https://my-server/v1
#
# ══════════════════════════════════════════════════════════════════
#  LEGACY vars — still work, used as fallback when PROVIDER is not set
# ══════════════════════════════════════════════════════════════════
VELARIS_CASE_AI_BACKEND=ollama

# --- Ollama (default — runs locally via Docker, no API key needed) ---
# To use a custom GGUF model: place the .gguf file in the repo-root models/ folder,
# then set VELARIS_CASE_AI_OLLAMA_MODEL to the filename without extension.
# Example: models/mistral-7b-q4.gguf  →  VELARIS_CASE_AI_OLLAMA_MODEL=mistral-7b-q4
VELARIS_CASE_AI_OLLAMA_URL=http://localhost:11434
VELARIS_CASE_AI_OLLAMA_MODEL=llama3.2
VELARIS_CASE_AI_OLLAMA_EMBED_MODEL=nomic-embed-text

# --- OpenAI ---
VELARIS_CASE_AI_OPENAI_API_KEY=
VELARIS_CASE_AI_OPENAI_MODEL=gpt-4o-mini
VELARIS_CASE_AI_OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Anthropic ---
VELARIS_CASE_AI_ANTHROPIC_API_KEY=
VELARIS_CASE_AI_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- NLP case generation ---
# VELARIS_CASE_NLP_ENABLED=true
# Use heuristic fallback when the LLM is unavailable.
# VELARIS_CASE_NLP_FALLBACK_ENABLED=true

# ════════════════════════════════════════════════════════════════════
#  SERVICE RUNTIME
# ════════════════════════════════════════════════════════════════════

# VELARIS_CASE_SERVICE_NAME=helix-case-service
# VELARIS_CASE_SERVICE_HOST=0.0.0.0
# VELARIS_CASE_SERVICE_PORT=8200
#
# Ports. Commented on purpose: the values below ARE the defaults, and an
# install that says nothing keeps exactly the ports the platform has always
# used. Uncomment one only to MOVE it — for a machine where something else
# already holds that number.
#
# `setup-velaris.sh` checks all of them before anything binds and offers an
# alternative when one is taken; `update-velaris.sh` checks too, and halts
# before touching anything rather than failing halfway through. A port held by
# Velaris itself is not a clash — that is just the platform running.
#
# Whatever is set here is what the gateway's upstreams, the systemd units and
# the launch script all use; nothing repeats a literal any more.
# VELARIS_ENGINE_PORT=8100
# VELARIS_CASE_PORT=8201
# VELARIS_ANALYTICS_PORT=8202
# VELARIS_HXGRAPH_PORT=8203
# VELARIS_HXMIGRATE_PORT=8204
# VELARIS_STUDIO_PORT=5173
# Debug mode relaxes CORS and disables the global rate limiter — never in prod.
# VELARIS_CASE_DEBUG=false

# ── Workflow engine ──
# VELARIS_CASE_TEMPORAL_HOST=localhost:7233
# VELARIS_CASE_TEMPORAL_NAMESPACE=default
# VELARIS_CASE_TEMPORAL_TASK_QUEUE=helix-case-queue
# VELARIS_CASE_ENGINE_API_URL=http://localhost:8100

# ════════════════════════════════════════════════════════════════════
#  DOCUMENT STORAGE
# ════════════════════════════════════════════════════════════════════

# "local" (default) or "s3". setup-velaris.sh writes "local" on a new install:
# documents live under VELARIS_CASE_STORAGE_LOCAL_PATH, encrypted with
# VELARIS_CASE_STORAGE_MASTER_KEY. Put that folder in your backup. A NAS works
# by mounting it and pointing that path at the mount.
#
# "s3" stores them in an S3-compatible service YOU run or rent (SeaweedFS,
# Garage, Ceph RGW, a NAS's S3 service, AWS S3, …). No S3 server ships with
# Velaris. For an endpoint on ANOTHER machine set VELARIS_CASE_S3_SECURE=true —
# the default (false) sends documents over plain HTTP, and the service logs a
# SECURITY WARNING at start when it is left that way.
# VELARIS_CASE_STORAGE_BACKEND=local
# VELARIS_CASE_S3_ENDPOINT=host:port
# VELARIS_CASE_S3_ACCESS_KEY=
# VELARIS_CASE_S3_SECRET_KEY=
# VELARIS_CASE_S3_BUCKET=velaris-docs
# VELARIS_CASE_S3_SECURE=true
#
# Installs created before v3.1.1: your "minio" backend value and any
# VELARIS_CASE_MINIO_* settings keep working unchanged — the S3 names above are
# the same settings, and win if both are present. Your bundled MinIO container
# keeps running. To move to local disk see scripts/storage-migrate.py;
# VELARIS_BUNDLED_MINIO=0 then stops the container being started.

# ════════════════════════════════════════════════════════════════════
#  SCALING — REDIS & RATE LIMITING
# ════════════════════════════════════════════════════════════════════

# Enable Redis for real-time fan-out and the distributed rate limiter.
# VELARIS_CASE_REDIS_ENABLED=false
# VELARIS_CASE_REDIS_URL=redis://localhost:6379/0
# VELARIS_CASE_REDIS_CHANNEL_PREFIX=helix:rt:
# Rate-limit backend: "memory" (single process) or "redis" (multi-worker).
# VELARIS_CASE_RATE_LIMIT_BACKEND=memory

# ════════════════════════════════════════════════════════════════════
#  CONNECTOR EXECUTOR LIMITS
# ════════════════════════════════════════════════════════════════════

# VELARIS_CASE_CONNECTOR_PAGINATION_DEFAULT_SIZE=50
# Response bodies above this overflow to object storage (bytes).
# VELARIS_CASE_CONNECTOR_OVERFLOW_THRESHOLD_BYTES=262144
# Responses above this are rejected and sent to the DLQ (bytes).
# VELARIS_CASE_CONNECTOR_HARD_REJECT_BYTES=16777216

# ════════════════════════════════════════════════════════════════════
#  HXMIGRATE CREATOR — enables "Apply to Velaris" in migration runs
# ════════════════════════════════════════════════════════════════════

# Service token for Creator API calls (alternative to user JWT).
# If set alongside a logged-in user JWT, the UI shows a selector.
# Generate: openssl rand -hex 32
# VELARIS_SERVICE_TOKEN=

# Override internal service URL if case-service is not on localhost:8200
# VELARIS_CASE_SERVICE_URL=http://localhost:8200

# Additional internal hostnames the Creator is allowed to call (comma-separated)
# VELARIS_INTERNAL_HOSTS=case-service.internal,api.internal

# ════════════════════════════════════════════════════════════════════
#  PUSH NOTIFICATIONS (P27)
# ════════════════════════════════════════════════════════════════════

# FCM (Firebase Cloud Messaging — Android)
# FCM_SERVICE_ACCOUNT_JSON_PATH=/path/to/firebase-service-account.json
# FCM_SERVICE_ACCOUNT_JSON_CONTENT={}   # alternative: inline JSON

# APNs (Apple Push Notification service — iOS)
# APNS_KEY_PEM=-----BEGIN PRIVATE KEY-----...
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
# APNS_BUNDLE_ID=com.example.helix
# APNS_SANDBOX=true

# Web Push (VAPID)
# VAPID_PRIVATE_KEY=<base64url DER>
# VAPID_PUBLIC_KEY=<base64url DER>
# VAPID_SUBJECT=mailto:admin@example.com

# ════════════════════════════════════════════════════════════════════
#  EMAIL (P25)
# ════════════════════════════════════════════════════════════════════

# VELARIS_CASE_SMTP_HOST=localhost
# VELARIS_CASE_SMTP_PORT=1025

# ════════════════════════════════════════════════════════════════════
#  HXMEET — REAL-TIME CASE SESSIONS (P66)
# ════════════════════════════════════════════════════════════════════

# Per-platform default session driver: off_platform (Teams/Zoom/Meet via
# connectors) or embedded (self-hosted LiveKit). Tenants can override.
# VELARIS_CASE_MEET_DRIVER=off_platform

# Embedded driver (LiveKit) — all three required or embedded fail-closes 501.
# Secrets are normally pushed via OpenBao (secrets-push.sh), not set here.
# VELARIS_CASE_LIVEKIT_URL=ws://127.0.0.1:7880
# VELARIS_CASE_LIVEKIT_API_KEY=
# VELARIS_CASE_LIVEKIT_API_SECRET=

# Sealed recordings: shared dir with the livekit-egress container.
# Empty = recording endpoints fail closed with 501.
# VELARIS_CASE_MEET_RECORDINGS_DIR=

# Post-session transcription model (P4a session intelligence, CPU).
# VELARIS_CASE_MEET_WHISPER_MODEL=base

# Live captions (P4a-live): streaming ASR backend — auto probes the machine
# (NVIDIA>CUDA, AMD/Intel GPU>whisper.cpp Vulkan, else CPU lag mode).
# Requires the optional ".[intelligence]" extras (pywhispercpp/faster-whisper).
# VELARIS_CASE_MEET_ASR_BACKEND=auto
# VELARIS_CASE_MEET_ASR_LIVE_MODEL=small

# ── HxLedger (§8.4) — double-entry postings ────────────────────────
# Post captured payments and refunds into the books. ON by default: a
# ledger with no postings is worthless, and /ledger/reconcile reports
# every captured payment as a discrepancy until something keeps it.
# Purely additive — new rows only, no existing payment path changes.
# VELARIS_CASE_LEDGER_POSTING_ENABLED=true

# ── HxDR (§8.9) — which region a recorded backup belongs to ────────
# ESCAPE HATCH, not configuration. Mark a region primary in HxGlobal
# instead — `region_registry` is the source of truth for regions, and
# it outranks this variable deliberately. An env var that overrode the
# primary flag would put two answers to "which region is this" in the
# system with no way to tell from the UI which one won.
#
# Resolution order: --region flag > primary region in HxGlobal > this
# variable > the sole region if only one exists > none (with a warning).
#
# Only reached when several regions are registered and NONE is primary.
# A backup recorded with no region is invisible to /dr/posture, so the
# CLI warns loudly rather than appearing to have worked.
# VELARIS_DR_REGION_ID=

# ── HxPrivacy (§8.10) — scheduled scan & export redaction ─────────
# The PII inventory was only as current as the last manual scan, and a
# stale inventory still looks authoritative. Safe to run unattended:
# a rescan can never re-open a dismissal or undo a confirmation.
# Interval is floored at 1h by the scanner; first run waits 5 min.
# VELARIS_CASE_PII_SCANNER_ENABLED=true

# HxShield live detection (roadmap #25). Default OFF.
#
# When on, every recorded security event is scored against the enabled HxShield
# rules and a firing rule raises an incident. Off by default because the
# engine's eight patterns had never run against real traffic before 2026-08-24:
# turn it on, watch what fires, then decide. Read per event, so it takes effect
# without a restart.
#
# Six of the eight patterns currently have no producer — nothing writes
# case_created / portal_submit / case_read / form_submit as a security event —
# so only account_takeover and off_hours_bulk_access can fire today. See
# docs/components/hxshield.md.
# VELARIS_CASE_HXSHIELD_DETECT_ENABLED=false

# HxShield RESPONSES (roadmap #25) — the half that ACTS. OFF.
#
# HxShield has computed a response for every incident since it shipped — flag,
# alert, suspend, block — and until 2026-09-09 nothing performed one. With this
# unset, that is still true and deliberately so: every response is RECORDED as
# what would have happened, and none is performed, so an operator can read a
# week of it before anything acts. An automated response that surprises its
# operator is switched off permanently on its first false positive.
#
# Even ON, a DESTRUCTIVE response still waits for a person — suspending an
# account, revoking every session. This switch governs the reversible ones.
# VELARIS_CASE_SHIELD_RESPONSE_ENABLED=false

# ── OCR (market gap A1) ───────────────────────────────────────────
# "" or "stub" = no OCR, which is what this platform has always done: the only
# engine returned an empty string, so a SCANNED page yielded nothing and
# nothing said so. "tesseract" runs the LOCAL binary — the sovereignty choice,
# since OCR is the classic thing to send to somebody else's cloud.
#
# Requires `tesseract-ocr` installed (and poppler-utils for PDFs). A configured
# engine with no binary logs an ERROR and falls back rather than returning an
# empty string forever.
#
# Off by default even where the binary is present: switching it on changes what
# a document CONTAINS as far as search, HxPrivacy's scan and every AI path are
# concerned, which is an operator's decision, not an update's.
# VELARIS_CASE_OCR_ENGINE=
# VELARIS_CASE_OCR_LANGUAGE=eng

# ── Gateway limits (nginx) ────────────────────────────────────────
# The ceilings the API gateway enforces. Every default below is the value it
# already enforces, so leaving these unset renders exactly today's config.
#
# NOTE: nginx validates a rate when it STARTS, so a typo here is not a bad
# ceiling — it is a gateway that will not boot. setup-velaris.sh and
# update-velaris.sh both check the shape before touching anything.
#
# VELARIS_GW_RATE_API=20r/s
# VELARIS_GW_RATE_PORTAL=30r/m
# Concurrent websocket connections per source ADDRESS. High on purpose: a whole
# office is one address behind NAT, and a cap that breaks a floor of staff is
# worse than the exhaustion it prevents.
# VELARIS_GW_WS_CONN_MAX=256
# VELARIS_CASE_PII_SCANNER_INTERVAL=86400
#
# Mask CONFIRMED personal data in exports that LEAVE the tenant
# (billing export, saved analytics reports). OFF by default.
# Deliberately NOT applied to the GDPR Article 15 export, whose whole
# purpose is disclosing that data to the subject it belongs to.
# VELARIS_CASE_PII_REDACT_EXPORTS=false

# ── Retention scheduler ───────────────────────────────────────────
# Applies retention policies unattended. OFF by default: every other
# background job here is additive, this one DELETES.
#
# TWO switches on purpose. ENABLED alone only logs what would go —
# actually deleting needs APPLY as well. A single flag is easy to
# flip while skim-reading a config; two is not. There is deliberately
# no "enabled implies apply".
#
# First run waits 24h after boot, so a bad policy deployed today can
# be noticed and stopped before it acts.
# VELARIS_CASE_RETENTION_SCHEDULER_ENABLED=false
# VELARIS_CASE_RETENTION_SCHEDULER_APPLY=false
# VELARIS_CASE_RETENTION_SCHEDULER_INTERVAL=86400

# ── Workload identity (roadmap #18) ──────────────────────────────────
# The gateway injects this on every request it proxies; each service refuses
# anything without it, so no local process can reach a service port directly and
# skip the gateway. Generate with: openssl rand -hex 32
# EMPTY = the check is OFF (an upgrade must not lock an install out of its API).
# Changing it needs BOTH the gateway recreated and the services restarted.
VELARIS_GATEWAY_IDENTITY_SECRET=

# ── Internal TLS (roadmap #18) — off by default ──────────────────────
# Everything talks over host loopback behind a loopback-only gateway, so mTLS
# would encrypt traffic nothing can reach. Turn it on when a service moves to
# another host: deploy/tls/make-internal-ca.sh, then set both of these.
# See deploy/tls/README.md.
VELARIS_INTERNAL_TLS_ENABLED=false
VELARIS_UPSTREAM_SCHEME=http

# ── Strict tenant reads on cases — OFF by default ────────────────────
# `case_instances.tenant_id` is nullable, and a NULL tenant has always meant
# "platform-shared": every release reads such a case for every tenant. That is
# why a case created without a tenant is readable across tenant boundaries.
#
# EMPTY / false = exactly the behaviour of every released version. Leave it
# alone on an existing install unless you have done the two steps below.
#
# To close it:
#   1. Apply migrations/*/197_case_tenant_backfill.sql. It stamps every case it
#      can prove ownership of and PRINTS how many it could not:
#         cases_still_without_a_tenant
#   2. Only when that number is 0, set this to true and restart the services.
#
# Turning it on while cases still have no tenant HIDES THOSE CASES FROM
# EVERYONE, their rightful owner included. The number in step 1 is the check.
#
# Two things change when it is on: a NULL-tenant case is no longer readable by
# anyone but a superadmin, and creating a case that would land with no tenant is
# refused (VEL-CASE-TENANT-403) rather than silently written and then invisible.
VELARIS_CASE_TENANT_STRICT_READS=false
